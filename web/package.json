{
  "name": "journali-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node build-help.mjs && vite",
    "build": "node build-help.mjs && vite build && node build-plugins.mjs",
    "test": "node --import ./test/vue-loader.mjs --test --test-concurrency=2 \"test/**/*.test.mjs\"",
    "build:web": "node build-help.mjs && vite build",
    "build:help": "node build-help.mjs",
    "build:plugins": "node build-plugins.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "marked": "^18.0.14",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
