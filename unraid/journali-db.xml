<?xml version="1.0"?>
<!--
  Unraid-Vorlage für die Datenbank von journali: Postgres 18 mit der Erweiterung `vector` (Image pgvector/pgvector:pg18).
  Ohne diese Erweiterung fehlen die Suche nach Sinn, die Frage an die Dokumente und das Band „Ähnliche Knoten“ — der
  Rest von journali läuft auch ohne. Dieselbe Version wie im Paket (compose.yaml).

  Das Datenverzeichnis liegt ab Postgres 18 unter /var/lib/postgresql/<major>/docker; der Mount gehört darum auf den
  Elternordner /var/lib/postgresql, damit ein Wechsel der Hauptversion später Platz hat.

  Das Passwort steht hier nicht: es wird beim Anlegen des Containers eingetragen (Feld maskiert) und danach einmal je
  Server im Einrichtungsdialog von journali angegeben; dort landet es in db.json im Datenverzeichnis.
-->
<Container version="2">
  <Name>journali-db</Name>
  <Repository>pgvector/pgvector:pg18</Repository>
  <Registry>https://hub.docker.com/r/pgvector/pgvector</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/journalipim/journali/issues</Support>
  <Project>https://journali.de</Project>
  <ReadMe>https://github.com/journalipim/journali#readme</ReadMe>
  <Overview>PostgreSQL 18 with the vector extension: the database for journali. journali creates the extension itself on its first start. Set the password here; the first visit of the journali web UI asks for it again.</Overview>
  <Category>Productivity: Tools:</Category>
  <TemplateURL>https://raw.githubusercontent.com/journalipim/journali/master/unraid/journali-db.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/journalipim/journali/master/unraid/journali.png</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <Config Name="Port" Target="5432" Default="5432" Mode="tcp" Description="Port of the database; journali connects to it" Type="Port" Display="always" Required="true" Mask="false">5432</Config>
  <Config Name="Data" Target="/var/lib/postgresql" Default="/mnt/user/appdata/journali-db" Mode="rw" Description="Data directory of the database" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/journali-db</Config>
  <Config Name="POSTGRES_PASSWORD" Target="POSTGRES_PASSWORD" Default="" Mode="" Description="Password of the user postgres; the same password goes into the setup dialog of journali" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="POSTGRES_USER" Target="POSTGRES_USER" Default="postgres" Mode="" Description="Database user" Type="Variable" Display="advanced" Required="false" Mask="false">postgres</Config>
  <Config Name="POSTGRES_DB" Target="POSTGRES_DB" Default="journali" Mode="" Description="Name of the database" Type="Variable" Display="advanced" Required="false" Mask="false">journali</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Berlin" Mode="" Description="Time zone of the container" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
</Container>
