<?xml version="1.0"?>
<!--
  Unraid-Vorlage für die Datenbank von journali: Postgres 18 mit der Erweiterung `vector` (Image pgvector/pgvector:pg18).
  Ohne diese Erweiterung fehlen die Suche nach Sinn, die Frage an die Dokumente und das Band „Ähnliche Knoten“ — der
  Rest von journali läuft auch ohne. Dieselbe Fassung wie im Paket (compose.yaml).

  Das Datenverzeichnis liegt ab Postgres 18 unter /var/lib/postgresql/<major>/docker; der Mount gehört darum auf den
  Elternordner /var/lib/postgresql, damit ein Wechsel der Hauptfassung später Platz hat.

  Das Passwort steht hier nicht: es wird beim Anlegen des Containers eingetragen (Feld maskiert) und danach einmal je
  Server im Einrichtungsdialog von journali angegeben; dort landet es in db.json im Datenverzeichnis.
-->
<Container version="2">
  <Name>journali-db</Name>
  <Repository>pgvector/pgvector:pg18</Repository>
  <Registry>https://hub.docker.com/r/pgvector/pgvector</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://journali.de</Support>
  <Project>https://journali.de</Project>
  <Overview>PostgreSQL 18 mit der Erweiterung vector — die Datenbank für journali. Die Erweiterung legt journali beim ersten Start selbst an. Das Passwort wird hier vergeben und danach im Einrichtungsdialog von journali eingetragen.</Overview>
  <Category>Productivity: Tools:</Category>
  <TemplateURL/>
  <Icon>https://journali.de/logo-128.png</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <Config Name="Port" Target="5432" Default="5432" Mode="tcp" Description="Port der Datenbank — journali verbindet sich damit" Type="Port" Display="always" Required="true" Mask="false">5432</Config>
  <Config Name="Daten" Target="/var/lib/postgresql" Default="/mnt/user/appdata/journali-db" Mode="rw" Description="Datenverzeichnis der Datenbank" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/journali-db</Config>
  <Config Name="POSTGRES_PASSWORD" Target="POSTGRES_PASSWORD" Default="" Mode="" Description="Passwort des Benutzers postgres — dasselbe wird im Einrichtungsdialog von journali eingetragen" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="POSTGRES_USER" Target="POSTGRES_USER" Default="postgres" Mode="" Description="Benutzer der Datenbank" Type="Variable" Display="advanced" Required="false" Mask="false">postgres</Config>
  <Config Name="POSTGRES_DB" Target="POSTGRES_DB" Default="journali" Mode="" Description="Name der Datenbank" Type="Variable" Display="advanced" Required="false" Mask="false">journali</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Berlin" Mode="" Description="Zeitzone" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
</Container>
