{
  "key": "excel",
  "version": "1.0.1",
  "label": {
    "de": "Excel",
    "en": "Excel"
  },
  "description": {
    "de": "Excel-Arbeitsmappen (.xlsx, .xls, .ods) als Tabelle für ⇩ Import → Tabelle — jedes Blatt wählbar, erste Zeile = Spaltennamen. Liest SheetJS (xlsx.mjs, Apache-2.0) im Browser.",
    "en": "Excel workbooks (.xlsx, .xls, .ods) as a table — any sheet, first row = column names. Uses SheetJS (xlsx.mjs, Apache-2.0) in the browser."
  },
  "kind": "io",
  "runs": "browser",
  "entry": "entry.js",
  "requires": [
    "table",
    "tasker"
  ],
  "autoInstall": true,
  "processes": [
    {
      "key": "import",
      "command": "node",
      "args": [
        "import-job.mjs",
        "{journali}",
        "{actor}",
        "{source}",
        "{profile}",
        "{dryRun}"
      ],
      "files": {
        "in": {
          "pattern": "*.xlsx;*.xlsm",
          "mode": "one",
          "order": "name",
          "param": "source"
        }
      },
      "params": [
        {
          "key": "profile",
          "label": "Profil — in der Ansicht des Plugins anlegen (Zuordnung, Ziel im Baum, Rolle)",
          "type": "profile",
          "default": "",
          "perJob": true
        },
        {
          "key": "source",
          "label": "Quelle: Datei oder Verzeichnis (dann die neueste) — leer = Fach in/ des Jobs",
          "type": "path",
          "default": "",
          "perJob": true
        },
        {
          "key": "dryRun",
          "label": "Trockenlauf (nur rechnen, nichts schreiben)",
          "type": "boolean",
          "default": "false",
          "perJob": true
        }
      ],
      "label": "Import: Excel",
      "description": "Eine Excel-Datei mit einem gespeicherten Profil des Excel-Imports einspielen — Zuordnung, Ziel im Baum und Rolle stehen im Profil"
    },
    {
      "command": "node",
      "args": [
        "export-job.mjs",
        "{journali}",
        "{actor}",
        "{root}",
        "{dir}",
        "{name}",
        "{locales}",
        "{role}",
        "{view}",
        "{ownOnly}",
        "{keep}",
        "{pub}"
      ],
      "description": "Teilbaum oder Ausleitung eines Publikationsbaums als Excel in ein Verzeichnis — je Wurzel eine Datei, die letzten n bleiben",
      "files": {
        "out": {
          "many": true,
          "param": "dir"
        }
      },
      "params": [
        {
          "key": "profile",
          "label": "Profil — in der Ansicht des Plugins anlegen (Teilbaum, Sprachen, Sicht …)",
          "type": "profile",
          "default": "",
          "perJob": true
        },
        {
          "key": "pub",
          "label": "Publikationsbaum (Ausleitung: freigegeben für den Kanal, im Markt verkauft; leer = Teilbaum unten)",
          "type": "pub",
          "default": "",
          "perJob": false
        },
        {
          "key": "root",
          "label": "Teilbaum (nur ohne Publikationsbaum; leer = alle Wurzeln)",
          "type": "node",
          "default": "",
          "perJob": false
        },
        {
          "key": "dir",
          "label": "Verzeichnis — leer = Fach out/ des Jobs (Fächer)",
          "type": "dir",
          "default": "export",
          "perJob": true
        },
        {
          "key": "name",
          "label": "Dateiname — {wurzel} {id} {zeit} {format}; leer = <Wurzel>-<Id>-<Zeit>",
          "type": "text",
          "default": "",
          "perJob": true
        },
        {
          "key": "locales",
          "label": "Sprachen (Codes, mit Komma; leer = Leitsprache)",
          "type": "text",
          "default": "",
          "perJob": false
        },
        {
          "key": "role",
          "label": "Knoten: group, product, variant oder leer = alle",
          "type": "text",
          "default": "",
          "perJob": false
        },
        {
          "key": "view",
          "label": "Sicht (Schlüssel; leer = alle Attribute)",
          "type": "text",
          "default": "",
          "perJob": false
        },
        {
          "key": "ownOnly",
          "label": "nur eigene Werte (geerbte leer lassen)",
          "type": "boolean",
          "default": "false",
          "perJob": false
        },
        {
          "key": "keep",
          "label": "so viele Staende behalten (je Wurzel, dieser Job)",
          "type": "number",
          "default": "14",
          "perJob": true
        }
      ],
      "key": "export",
      "label": "Export: Excel"
    }
  ]
}
