{
  "key": "export",
  "version": "1.2.0",
  "label": {
    "de": "Export: Tabelle",
    "en": "Export: table"
  },
  "description": {
    "de": "Job zu ⇪ Export → Tabelle (Basis-Plugin table): dieselbe Tabelle regelmäßig als Excel oder CSV in ein Verzeichnis — je Wurzel eine Datei, die letzten n bleiben. Braucht table (Kern) und tasker (Jobs).",
    "en": "Job for the table export: the same table written to a directory as Excel or CSV on a schedule. Needs table and tasker."
  },
  "kind": "export",
  "runs": "process",
  "process": {
    "command": "node",
    "args": [
      "job.mjs",
      "{journali}",
      "{actor}",
      "{root}",
      "{dir}",
      "{format}",
      "{locales}",
      "{role}",
      "{view}",
      "{ownOnly}",
      "{keep}"
    ],
    "description": "Teilbaum als Excel oder CSV in ein Verzeichnis — je Wurzel eine Datei, die letzten n bleiben",
    "params": [
      {
        "key": "root",
        "label": "Teilbaum (leer = alle Wurzeln)",
        "type": "node",
        "default": ""
      },
      {
        "key": "dir",
        "label": "Verzeichnis",
        "type": "text",
        "default": "export"
      },
      {
        "key": "format",
        "label": "Format (xlsx oder csv)",
        "type": "text",
        "default": "xlsx"
      },
      {
        "key": "locales",
        "label": "Sprachen (Codes, mit Komma; leer = Leitsprache)",
        "type": "text",
        "default": ""
      },
      {
        "key": "role",
        "label": "Knoten: group, product, variant oder leer = alle",
        "type": "text",
        "default": ""
      },
      {
        "key": "view",
        "label": "Sicht (Schlüssel; leer = alle Attribute)",
        "type": "text",
        "default": ""
      },
      {
        "key": "ownOnly",
        "label": "nur eigene Werte (geerbte leer lassen)",
        "type": "boolean",
        "default": "false"
      },
      {
        "key": "keep",
        "label": "so viele Stände behalten (je Wurzel, dieser Job)",
        "type": "number",
        "default": "14"
      }
    ]
  },
  "autoInstall": true,
  "requires": [
    "table",
    "tasker"
  ]
}
