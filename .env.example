# Nach .env kopieren, wenn etwas davon gebraucht wird. .env bleibt ausserhalb des Repos.
# Datenbankpasswort: leer lassen, dann erzeugt es der erste Start. Steht hier eines, nimmt der erste Start dieses.
# Spaeter aendern wirkt nicht — Postgres uebernimmt ein Passwort nur beim allerersten Start.
JOURNALI_DB_PASSWORD=
# Medien im Object Storage (JOURNALI_MEDIA: s3://bucket in compose.yaml) - Key und Secret nur hier, nie im Repo
JOURNALI_S3_KEY=
JOURNALI_S3_SECRET=
# Nur fuer compose.extern.yaml: die schon vorhandene Datenbank
JOURNALI_DB_HOST=
JOURNALI_DB_PORT=5432
